# Encrypted bot registry (agent keys)
.bots.enc.json

# Dependencies — reinstalled from package-lock.json
node_modules/

# Build output — regenerated by `npm run build` on the server
dist/
dev-dist/

# Local env / logs
.env
.env.local
*.log
logs/
pulse-volume.json
sub-payments.json
chat-deleted.json
chat.json
# Inbox for community bot submissions. Holds submitters' IP addresses; never commit it.
bot-submissions.json

# Runtime caches written by serve-prod.js (icons, profile pictures)
data/

# Playwright screenshots from local verification runs
/*.png
